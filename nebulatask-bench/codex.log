#"'!/usr/bin/env python3
import os, json, sys, tarfile, io, pickle, shutil
from pathlib import Path

with open('"'/tmp/package_to_tar.pkl', 'rb') as f:
    pkg_map = pickle.load(f)

ROOT = Path('/Users/lucca/bench/codex')
NM = ROOT / 'node_modules'

WANTED = {
    'react': '19.2.7',
    'react-dom': '19.2.7',
    'typescript': '5.8.3',
    'vite': '8.1.4',
    '@vitejs/plugin-react': '6.0.3',
    '@tailwindcss/vite': '4.3.2',
    'tailwindcss': '4.3.2',
    '@types/react': '19.2.17',
    '@types/react-dom': '19.2.3',
    '@types/node': '24.13.3',
}

def extract_tarball(tar_path, dest_dir):
    dest_dir.mkdir(parents=True, exist_ok=True)
    with tarfile.open(tar_path, 'r:*') as tar:
        for member in tar.getmembers():
            name = member.name
            if name.startswith('package/'):
                name = name[len('package/'):]
            elif name == 'package':
                continue
            member.name = name
            if not name:
                continue
            try:
                tar.extract(member, dest_dir)
            except Exception as e:
                pass

def target_dir_for(name):
    if name.startswith('@'):
        scope, pkg = name[1:].split('/', 1)
        return NM / ('@' + scope) / pkg
    return NM / name

def install_deps(name, version, installed):
    if (name, version) in installed:
        return
    installed.add((name, version))
    target = target_dir_for(name)
    if target.exists() and (target / 'package.json').exists():
        # already installed
        try:
            pj_data = json.loads((target / 'package.json').read_text())
        except Exception:
            return
    else:
        if name not in pkg_map or version not in pkg_map[name]:
            print(f\"  MISS: {name}@{version}\")
            return
        tar = pkg_map[name][version]
        print(f\"  + {name}@{version}\")
        extract_tarball(tar, target)
        try:
            pj_data = json.loads((target / 'package.json').read_text())
        except Exception:
            print(f\"  ERROR reading package.json for {name}\")
            return
    deps = pj_data.get('dependencies') or {}
    for dep_name, dep_ver_range in deps.items():
        if dep_name not in pkg_map:
            print(f\"  DEPS MISS: {dep_name} not in cache\")
            continue
        available = sorted(pkg_map[dep_name].keys(), reverse=True)
        if not available:
            continue
        chosen = available[0]
        install_deps(dep_name, chosen, installed)

if NM.exists():
    shutil.rmtree(NM)
NM.mkdir()

for name, ver in WANTED.items():
    print(f\"\\n=== {name}@{ver} ===\")
    install_deps(name, ver, set())

print(\"\\nDone"'!")
print("'"\\nTop-level packages in node_modules:\")
for entry in sorted(os.listdir(NM)):
    p = NM / entry
    if p.is_dir():
        if entry.startswith('@'):
            for sub in sorted(os.listdir(p)):
                print(f\"  {entry}/{sub}\")
        else:
            print(f\"  {entry}\")
