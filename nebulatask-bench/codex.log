#"'!/usr/bin/env python3
"""Install npm packages offline by extracting tarballs from npm cache."""
import os, json, sys, tarfile, io, pickle, shutil
from pathlib import Path

# Load package -> tarball map
with open('"'/tmp/package_to_tar.pkl', 'rb') as f:
    pkg_map = pickle.load(f)

ROOT = Path('/Users/lucca/bench/codex')
NM = ROOT / 'node_modules'

# Versions to use (from cache)
WANTED = {
    'react': '19.2.7',
    'react-dom': '19.2.7',
    # dev deps
    'typescript': '5.8.3',
    'vite': '8.1.4',
    '@vitejs/plugin-react': '6.0.3',
    '@tailwindcss/vite': '4.3.2',
    'tailwindcss': '4.3.2',
    '@types/react': '19.2.17',
    '@types/react-dom': '19.2.3',
    '@types/node': '24.13.3',
}

def extract_tarball(tar_path, dest_dir):
    \"\"\"Extract tarball at tar_path into dest_dir. Each tarball has a 'package/' prefix.\"\"\"
    dest_dir.mkdir(parents=True, exist_ok=True)
    with tarfile.open(tar_path, 'r:*') as tar:
        for member in tar.getmembers():
            # Strip leading 'package/' prefix
            name = member.name
            if name.startswith('package/'):
                name = name[len('package/'):]
            elif name == 'package':
                continue
            member.name = name
            if not name:
                continue
            try:
                tar.extract(member, dest_dir)
            except Exception as e:
                print(f\"  WARN extract {name}: {e}\")

def install_pkg(name, version, dest):
    \"\"\"Install a package at the given version into dest (which is parent node_modules or scoped dir).\"\"\"
    pkg_full = f'{name}@{version}'
    if name not in pkg_map:
        print(f\"  MISS: {pkg_full} not in cache\")
        return None
    if version not in pkg_map[name]:
        print(f\"  MISS: {pkg_full} version not available (have {sorted(pkg_map[name])})\")
        return None
    tar = pkg_map[name][version]
    print(f\"  Extract {pkg_full}\")
    extract_tarball(tar, dest)
    # Read installed package.json
    pj = dest / 'package.json'
    if not pj.exists():
        print(f\"  ERROR: no package.json in {dest}\")
        return None
    return json.loads(pj.read_text())

def install_deps(name, version, installed=None):
    \"\"\"Recursively install a package and its deps.\"\"\"
    if installed is None:
        installed = set()
    if (name, version) in installed:
        return
    installed.add((name, version))

    # Determine target dir
    if name.startswith('@'):
        scope, pkg = name[1:].split('/', 1)
        target = NM / '@' + scope / pkg
    else:
        target = NM / name

    if target.exists():
        # already installed - skip
        pj = target / 'package.json'
        if pj.exists():
            print(f\"  Skip {name}@{version} (already installed)\")
            return
    pj_data = install_pkg(name, version, target)
    if pj_data is None:
        return
    deps = pj_data.get('dependencies') or {}
    for dep_name, dep_ver_range in deps.items():
        # Try to find matching version
        if dep_name not in pkg_map:
            print(f\"  DEPS MISS: {dep_name} not in cache (need {dep_ver_range})\")
            continue
        # Pick a compatible version - try matching exact, then latest cached
        available = sorted(pkg_map[dep_name].keys(), reverse=True)
        chosen = None
