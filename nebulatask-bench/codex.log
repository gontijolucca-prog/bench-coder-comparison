import os, json, hashlib, base64, gzip, glob, pickle

with open('/tmp/npm_index.pkl', 'rb') as f:
    all_entries = pickle.load(f)
with open('/tmp/npm_content.pkl', 'rb') as f:
    content_map = pickle.load(f)

# Index: key -> sha512-base64 (decompressed)
# Content: filename = sha512(raw)[4:]
# We need to verify: compute sha512(decompressed) == integrity
# Let's check a few
matched = 0
unmatched = 0
for key, entries in list(all_entries.items())[:50]:
    for ihash, size in entries:
        if not ihash.startswith('sha512-'):
            continue
        # decode to hex
        try:
            target_hex = base64.b64decode(ihash.split('-', 1)[1]).hex()
        except Exception:
            continue
        # Find in content_map: filename = full_hex[4:]
        suffix = target_hex[4:]
        if suffix in content_map:
            path = content_map[suffix]
            # verify by decompressing and checking sha512
            raw = open(path, 'rb').read()
            try:
                dec = gzip.decompress(raw)
            except Exception:
                continue
            actual_hex = hashlib.sha512(dec).hexdigest()
            if actual_hex == target_hex:
                matched += 1
            else:
                unmatched += 1
        else:
            unmatched += 1
print(f\"matched={matched} unmatched={unmatched}\")

# Now match all and produce: package_name -> version -> tarball_path
print()
package_to_tar = {}
matched_all = 0
unmatched_all = 0
for key, entries in all_entries.items():
    # Extract pkg and version from key
    if 'registry.npmjs.org/' not in key:
        continue
    url = key.split('registry.npmjs.org/', 1)[1].rstrip('/')
    if '/-/' not in url:
        continue
    parts = url.split('/-/')
    pkg = parts[0]
    fname = parts[1]
    ver = fname.rstrip('.tgz').rsplit('-', 1)[-1]
    for ihash, size in entries:
        if not ihash.startswith('sha512-'):
            continue
        try:
            target_hex = base64.b64decode(ihash.split('-', 1)[1]).hex()
        except Exception:
            continue
        suffix = target_hex[4:]
        if suffix in content_map:
            path = content_map[suffix]
            # verify
            raw = open(path, 'rb').read()
            try:
                dec = gzip.decompress(raw)
            except Exception:
                continue
            actual_hex = hashlib.sha512(dec).hexdigest()
            if actual_hex == target_hex:
                matched_all += 1
                package_to_tar.setdefault(pkg, {})[ver] = path
                break
            else:
                unmatched_all += 1
print(f\"Total matched: {matched_all}, unmatched: {unmatched_all}\")
print(f\"Unique packages: {len(package_to_tar)}\")

# Save
