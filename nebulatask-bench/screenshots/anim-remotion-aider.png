<!doctype html>
<html><head><meta charset="utf-8"><title>Aider Animation Test</title>
<style>body{margin:0;background:#0a0a0a;overflow:hidden}</style>
</head><body>
<div id="root"></div>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/remotion@4.0.0/dist/index.js"></script>
<script>
// Inline composition logic (simplified version)
function App() {
  const frame = 30;
  const x = frame * 3.33;
  const scale = frame < 60 ? 0.6 + (frame / 60) * 0.4 : 1;
  return React.createElement('div', {
    style: {
      width: '800px', height: '400px', backgroundColor: '#0a0a0a',
      position: 'relative', overflow: 'hidden',
      display: 'flex', alignItems: 'center', justifyContent: 'center'
    }
  }, [
    React.createElement('div', { 
      key: 'title',
      style: {position:'absolute',top:20,left:0,right:0,color:'#f5f5f5',textAlign:'center',fontSize:22,fontWeight:600}
    }, 'Aider Animation Challenge'),
    ['#FF6B5B', '#4ADE80', '#60A5FA'].map((color, i) =>
      React.createElement('div', {
        key: i,
        style: {
          position: 'absolute', left: x + i * 30, top: 170,
          width: 60, height: 60, borderRadius: '50%',
          backgroundColor: color, transform: `scale(${scale})`,
          boxShadow: '0 8px 24px rgba(0,0,0,0.35)'
        }
      })
    )
  ]);
}
ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body></html>
